default_platform(:ios)

platform :ios do
  desc "Build the IPA for LuminaPlayer"
  lane :build_ipa do
    # setup_ci # Configures keychain for CI environments

    # In a real scenario, you'd handle code signing here:
    # sync_code_signing(type: "adhoc") # using match

    build_app(
      scheme: "LuminaPlayer",
      workspace: "LuminaPlayer.xcodeproj", # or .xcworkspace
      include_bitcode: false,
      export_method: "ad-hoc", # or "app-store", "development"
      output_directory: "./build",
      output_name: "LuminaPlayer.ipa"
    )
  end
end
